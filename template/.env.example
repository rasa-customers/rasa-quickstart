# ------------------------------------------------------------------------------
# Rasa Quickstart — environment
# Copy this file to `.env` and fill in the values. `.env` is git-ignored, and
# Rasa loads it automatically when you run any `rasa` command.
# ------------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------
# Your Rasa Pro license key. Get one (free) at
# https://rasa.com/rasa-pro-developer-edition-license-key-request
RASA_LICENSE=

# --- LLM provider (active) ---------------------------------------------------
# The agent's orchestrator model group in integrations.yml uses OpenAI by
# default. Put your key here.
OPENAI_API_KEY=

# --- Alternate LLM providers -------------------------------------------------
# Uncomment the key you need and switch the `model_groups` block in
# integrations.yml (`llm.model_group` references the group by id).
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# --- Voice (optional) --------------------------------------------------------
# Lets you talk to the agent in the Inspector; configure `asr:` / `tts:` on a
# channel in integrations.yml first (see the bundled docs: /voice/overview).
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- MCP tools (optional) ----------------------------------------------------
# Used by the commented `mcp_servers:` example in integrations.yml.
# MCP_BANKING_TOKEN=

# --- Tracing / observability (optional) --------------------------------------
# Referenced from a `tracing:` block in integrations.yml.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# OTLP_ENDPOINT=
