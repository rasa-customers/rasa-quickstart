# ------------------------------------------------------------------------------
# Rasa Quickstart — environment
# Copy this file to `.env` and fill in the values. `.env` is git-ignored, and
# Rasa loads it automatically when you run any `rasa` command.
# ------------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------
# Your Rasa Pro license key. Get one at https://rasa.com/
RASA_LICENSE=

# --- LLM provider (active) ---------------------------------------------------
# The default CALM config (config.yml) uses OpenAI. Put your key here.
OPENAI_API_KEY=

# --- Alternate LLM providers -------------------------------------------------
# Uncomment the key you need and switch the `model_groups` block in endpoints.yml
# (config.yml references the group by id).
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# --- Voice (optional) --------------------------------------------------------
# Uncomment to enable a voice channel; requires adding the channel to
# credentials.yml first (see https://rasa.com/docs/reference/config/channels/).
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Tracing / observability (optional) --------------------------------------
# OTLP_ENDPOINT=
# OTLP_INSECURE=true
# TRACING_SERVICE_NAME=rasa
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=
